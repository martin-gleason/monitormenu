#!/bin/zsh
# C1-T3: a register ID never appears anywhere in a commit message (conventions § Axis 2).
# Structural IDs (F1, C1, F1-T2) carry the work. Types are the conventions' seven.
msg=$(grep -vE '^#' "$1")
subject=$(printf '%s\n' "$msg" | head -1)
if printf '%s' "$msg" | grep -qiE '(^|[^A-Za-z0-9])(D|RR|O|H|M|A|G|FR|NFR)[0-9]+([^A-Za-z0-9]|$)'; then
  echo "commit-msg: register IDs (D, RR, O, H, M, A, G, FR, NFR) never appear in a commit message. Offending line:"
  printf '%s' "$msg" | grep -iE '(^|[^A-Za-z0-9])(D|RR|O|H|M|A|G|FR|NFR)[0-9]+([^A-Za-z0-9]|$)' | head -3 | sed 's/^/  /'
  exit 1
fi
if ! printf '%s' "$subject" | grep -qE '^(feat|fix|test|chore|docs|refactor|ci)(\([FC][0-9]+[a-z]?(-T[0-9]+)?(, ?[FC][0-9]+[a-z]?(-T[0-9]+)?)*\))?: .+'; then
  echo "commit-msg: subject must be <type>(<F/C id>): <description> with type feat|fix|test|chore|docs|refactor|ci — got \"$subject\""; exit 1
fi
