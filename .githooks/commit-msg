#!/bin/zsh
# C1-T3: a register ID never appears in a commit subject. Structural IDs (F1, C1, F1-T2) do.
subject=$(head -1 "$1")
if printf '%s' "$subject" | grep -qE '(^|[^A-Za-z0-9])(D|RR|O|H|M|A|G|FR|NFR)[0-9]+([^A-Za-z0-9]|$)'; then
  echo "commit-msg: register IDs (D, RR, O, H, M, A, G, FR, NFR) never appear in a commit subject: \"$subject\""; exit 1
fi
if ! printf '%s' "$subject" | grep -qE '^(feat|fix|docs|chore|test|refactor|build|ci)(\([FC][0-9]+[a-z]?(-T[0-9]+)?(, ?[FC][0-9]+[a-z]?(-T[0-9]+)?)*\))?: .+'; then
  echo "commit-msg: subject must be <type>(<F/C id>): <description> — got \"$subject\""; exit 1
fi
