#!/bin/zsh
# C1-T3: gates run after the last edit. swift test, the assertion floor, and a fresh status page.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: swift test"
if ! swift test >/tmp/monitormenu-precommit.log 2>&1; then tail -20 /tmp/monitormenu-precommit.log; echo "pre-commit: tests failed"; exit 1; fi
n=$(grep -E "Executed [0-9]+ tests?" /tmp/monitormenu-precommit.log | tail -1 | sed -E 's/.*Executed ([0-9]+) tests?.*/\1/')
floor=$(cat Tests/ASSERTION_FLOOR 2>/dev/null || echo 0)
if [[ "${n:-0}" -lt "$floor" ]]; then echo "pre-commit: executed=$n is below the floor of $floor (Tests/ASSERTION_FLOOR)"; exit 1; fi
echo "pre-commit: executed=$n floor=$floor"
GEN=~/Local_Dev_Projects/turing-review/scripts/gen_status.py
if [[ -f "$GEN" ]]; then python3 "$GEN" . --check || { echo "pre-commit: status page is stale — run: python3 $GEN ."; exit 1; }; fi
added=$(git diff --cached -U0 | grep -E '^\+' | grep -vE '^\+\+\+')
if printf '%s\n' "$added" | grep -qiE '(api[_-]?key|secret|password|passwd|token|authorization)["'"'"']?\s*[:=]\s*["'"'"']?[A-Za-z0-9/+_.=-]{16,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bAKIA[0-9A-Z]{16}\b|\bgh[pousr]_[A-Za-z0-9]{20,}\b|\bsk-[A-Za-z0-9]{20,}\b|\bxox[baprs]-[A-Za-z0-9-]{10,}\b|Bearer [A-Za-z0-9._-]{20,}'; then
  echo "pre-commit: possible secret in the diff:"; printf '%s\n' "$added" | grep -iE 'key|secret|password|passwd|token|authorization|AKIA|gh[pousr]_|sk-|xox|Bearer' | head -3 | cut -c1-120 | sed 's/^/  /'; exit 1
fi
exit 0
